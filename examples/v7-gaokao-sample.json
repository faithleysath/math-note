    },
    {
      "id": "c2s1s1",
      "type": "section",
      "title": "二次函数",
      "content": "",
      "parentId": "c2s1",
      "order": 1024,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "subsection"
    },
    {
      "id": "quadratic",
      "type": "definition",
      "title": "二次函数",
      "content": "形如 $f(x)=ax^2+bx+c$（$a\\ne 0$）的函数称为**二次函数**。",
      "parentId": "c2s1s1",
      "order": 1024,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "key": "quadratic-function"
    },
    {
      "id": "axis",
      "type": "proposition",
      "title": "对称轴公式",
      "content": "若 $a\\ne 0$，则 $f(x)=ax^2+bx+c$ 的图象关于直线 $x=-\\dfrac{b}{2a}$ 对称。",
      "parentId": "c2s1s1",
      "order": 2048,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "formula",
      "key": "quadratic-axis"
    },
    {
      "id": "axis-proof",
      "type": "proof",
      "title": "配方法",
      "content": "配方得 $f(x)=a\\left(x+\\dfrac{b}{2a}\\right)^2+c-\\dfrac{b^2}{4a}$，故对称轴为 $x=-\\dfrac{b}{2a}$。",
      "parentId": "axis",
      "order": 1024,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "direct"
    },
    {
      "id": "axis-proof-2",
      "type": "proof",
      "title": "利用对称性定义",
      "content": "设对称轴为 $x=t$，由 $f(t+h)=f(t-h)$ 对任意 $h$ 成立解出 $t=-\\dfrac{b}{2a}$。",
      "parentId": "axis",
      "order": 2048,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "geometric"
    },
    {
      "id": "axis-eg",
      "type": "problem",
      "title": "求二次函数的对称轴与最值",
      "content": "已知 $f(x)=2x^2-4x+1$。（1）求对称轴；（2）求最小值。",
      "parentId": "c2s1s1",
      "order": 3072,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "example",
      "solution": "（1）$x=1$；（2）$f(1)=-1$。"
    },
    {
      "id": "axis-attempt",
      "type": "attempt",
      "title": "第一次：配方算错符号",
      "content": "把 $-\\dfrac{b}{2a}$ 写成了 $\\dfrac{b}{2a}$。",
      "parentId": "axis-eg",
      "order": 1024,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "personal",
      "attempt": {
        "correct": false,
        "method": "配方法",
        "durationMin": 8
      }
    },
