    {
      "id": "c3s1",
      "type": "section",
      "title": "等差数列",
      "content": "",
      "parentId": "c3",
      "order": 1024,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "section"
    },
    {
      "id": "ap-def",
      "type": "definition",
      "title": "等差数列",
      "content": "若数列 $\\{a_n\\}$ 满足 $a_{n+1}-a_n=d$（$d$ 为常数），则称它是**等差数列**。",
      "parentId": "c3s1",
      "order": 1024,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "key": "arithmetic-sequence"
    },
    {
      "id": "ap-sum",
      "type": "proposition",
      "title": "等差数列前 n 项和",
      "content": "等差数列 $\\{a_n\\}$ 的前 $n$ 项和 $S_n=\\dfrac{n(a_1+a_n)}{2}=na_1+\\dfrac{n(n-1)}{2}d$。",
      "parentId": "c3s1",
      "order": 2048,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "formula",
      "key": "arithmetic-sum"
    },
    {
      "id": "ap-eg",
      "type": "problem",
      "title": "等差数列求和",
      "content": "已知等差数列首项为 $3$，公差为 $2$，求前 $10$ 项和。",
      "parentId": "c3s1",
      "order": 3072,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "exercise",
      "solution": "$S_{10}=10\\times 3+\\dfrac{10\\times 9}{2}\\times 2=120$。"
    },
    {
      "id": "m-method",
      "type": "note",
      "title": "求对称轴的方法",
      "content": "看到二次函数先配方，或者直接用 $x=-\\dfrac{b}{2a}$，注意 $a\\ne 0$。",
      "parentId": "c2s1s1",
      "order": 4096,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "method"
    },
    {
      "id": "m-context",
      "type": "note",
      "title": "实数范围",
      "content": "本图谱默认在实数范围内讨论；涉及取值范围时会在命题正文中写明。",
      "parentId": "high",
      "order": 4096,
