    {
      "id": "c1s1",
      "type": "section",
      "title": "集合",
      "content": "",
      "parentId": "c1",
      "order": 1024,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "section"
    },
    {
      "id": "set",
      "type": "definition",
      "title": "集合",
      "content": "把一些确定的、彼此不同的对象作为一个整体，就说这个整体是由这些对象组成的**集合**。",
      "parentId": "c1s1",
      "order": 1024,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "key": "set"
    },
    {
      "id": "subset",
      "type": "definition",
      "title": "子集",
      "content": "若集合 $A$ 中任意元素都属于 $B$，则称 $A$ 是 $B$ 的**子集**，记作 $A\\subseteq B$。",
      "parentId": "c1s1",
      "order": 2048,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "key": "subset"
    },
    {
      "id": "set-prop",
      "type": "proposition",
      "title": "子集的传递性",
      "content": "对任意集合 $A,B,C$，若 $A\\subseteq B$ 且 $B\\subseteq C$，则 $A\\subseteq C$。",
      "parentId": "c1s1",
      "order": 3072,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "property",
      "key": "subset-transitive"
    },
    {
      "id": "set-proof",
      "type": "proof",
      "title": "按定义逐元素验证",
      "content": "任取 $x\\in A$。由 $A\\subseteq B$ 得 $x\\in B$；再由 $B\\subseteq C$ 得 $x\\in C$，故 $A\\subseteq C$。",
      "parentId": "set-prop",
      "order": 1024,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "direct"
    },
    {
      "id": "set-eg",
      "type": "problem",
      "title": "判断子集关系",
      "content": "设 $A=\\{1,2\\}$，$B=\\{1,2,3\\}$。（1）判断 $A\\subseteq B$ 是否成立；（2）写出 $B$ 的所有子集个数。",
      "parentId": "c1s1",
      "order": 4096,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "example",
      "solution": "（1）成立；（2）$2^3=8$ 个。"
    },
    {
      "id": "c1s2",
      "type": "section",
      "title": "常用逻辑用语",
      "content": "",
      "parentId": "c1",
      "order": 2048,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "section"
    },
    {
      "id": "implies-def",
      "type": "definition",
      "title": "充分条件与必要条件",
      "content": "若 $p\\Rightarrow q$，则称 $p$ 是 $q$ 的**充分条件**，$q$ 是 $p$ 的**必要条件**。",
      "parentId": "c1s2",
      "order": 1024,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "key": "sufficient-necessary"
    },
    {
      "id": "p-pos",
      "type": "proposition",
      "title": "正数的平方为正",
      "content": "对任意实数 $x$，若 $x>0$，则 $x^2>0$。",
      "parentId": "c1s2",
      "order": 2048,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "property",
      "key": "positive-square"
    },
    {
      "id": "p-abs",
      "type": "proposition",
      "title": "平方为正则非零",
      "content": "对任意实数 $x$，若 $x^2>0$，则 $x\\ne 0$。",
      "parentId": "c1s2",
      "order": 3072,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "property",
      "key": "square-positive-nonzero"
    },
    {
      "id": "p-claim",
      "type": "proposition",
      "title": "错误的断言：平方为正则正",
      "content": "对任意实数 $x$，若 $x^2>0$，则 $x>0$。",
      "parentId": "c1s2",
      "order": 4096,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "claim"
    },
    {
      "id": "cex-neg",
      "type": "counterexample",
      "title": "取 x=-1",
      "content": "取 $x=-1$，则 $x^2=1>0$，但 $x<0$，故断言不成立。",
      "parentId": "p-claim",
      "order": 1024,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "numerical"
    },
