    },
    {
      "id": "m-history",
      "type": "note",
      "title": "函数概念的演变",
      "content": "函数概念从 Euler 的解析表达式，到 Dirichlet 的对应关系，再到集合论下的映射定义。",
      "parentId": "c2",
      "order": 2048,
      "createdAt": 1750000000000,
      "updatedAt": 1750000000000,
      "kind": "history"
    }
